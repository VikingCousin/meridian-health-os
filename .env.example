# Copy this file to .env and adjust if needed.

# SQLite database file, relative to prisma7.config.ts (the repo root).
DATABASE_URL="file:./data/app.db"

# Local directory where uploaded health documents (PDFs, images) are stored
# on disk. Never committed; file contents are never stored in the database.
HEALTH_UPLOADS_DIR="./data/uploads"

# --- AI extraction (optional) -----------------------------------------------
# Leave AI_PROVIDER unset to use the built-in mock extractors for lab reports
# and journal entries — no external API calls, works with zero configuration.
# Set it to "anthropic" or "openai" (plus the matching API key below) to turn
# on real multimodal lab extraction and real journal observation extraction.
# See docs/DATA_MODEL.md and docs/PRIVACY_ARCHITECTURE.md before enabling —
# with a provider configured, document images/PDFs and journal text are sent
# to that provider's API for extraction.
AI_PROVIDER=

# Required if AI_PROVIDER=anthropic. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required if AI_PROVIDER=openai. Get one at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
