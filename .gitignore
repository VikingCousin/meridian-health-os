# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE
.vscode/
.idea/

# Claude Code local tooling (skills symlinks, dev-server launch config)
/.claude/
skills-lock.json

# Auto-generated by `next dev` (agent-facing dev notes, not project docs)
/AGENTS.md
/CLAUDE.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is a committed template with no real secrets in
# it (see docs/PRIVACY_ARCHITECTURE.md); every other .env* variant is
# gitignored since that's where real API keys live.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# local-first data: sqlite db + uploaded health documents never get committed
/data/*.db
/data/*.db-journal
/data/uploads/*
!/data/uploads/.gitkeep
/data/test-*.db*
/data/backups/
/data/logs/*
!/data/logs/.gitkeep
