{
  "name": "health-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "start:network": "next start -H 0.0.0.0",
    "local:install": "bash scripts/local-service.sh install",
    "local:start": "bash scripts/local-service.sh start",
    "local:stop": "bash scripts/local-service.sh stop",
    "local:restart": "bash scripts/local-service.sh restart",
    "local:status": "bash scripts/local-service.sh status",
    "local:update": "bash scripts/local-service.sh update",
    "local:uninstall": "bash scripts/local-service.sh uninstall",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/check-safe-to-reset.ts && tsx scripts/backup-db.ts && prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:backup": "tsx scripts/backup-db.ts",
    "demo:reset": "ALLOW_DESTRUCTIVE_RESET=1 npm run db:reset",
    "db:wipe-to-real": "tsx scripts/check-safe-to-reset.ts && tsx scripts/backup-db.ts && tsx scripts/wipe-to-real.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
